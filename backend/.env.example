# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier
AUTH0_MGMT_CLIENT_ID=your-management-api-client-id
AUTH0_MGMT_CLIENT_SECRET=your-management-api-client-secret

# Google Places
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Used only by the one-off backend/generate-lqips.mjs script
SUPABASE_PROD_URL=https://your-prod-project.supabase.co
SUPABASE_PROD_SERVICE_ROLE_KEY=your-prod-service-role-key

# Discord
DISCORD_BUG_REPORT_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
