# Auth0
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_AUDIENCE=https://your-api-identifier

# Backend API
VITE_API_URL=http://localhost:3000

# Special users (theming/tutorial gating for specific accounts)
VITE_USER1_ID=auth0|user-id-1
VITE_USER2_ID=auth0|user-id-2
VITE_SPECIAL_USERS=user1,user2
